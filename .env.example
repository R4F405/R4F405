# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key for the intent extractor
ANTHROPIC_API_KEY=

# --- Optional ---
# Claude model used for intent extraction (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# Google Calendar (leave empty to use the mock calendar provider)
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCESS_TOKEN=

# Microsoft Graph bridge for the unified reminder/notes service
# (leave empty to use the in-memory mock)
MS_GRAPH_ACCESS_TOKEN=
MS_GRAPH_TODO_LIST_ID=
